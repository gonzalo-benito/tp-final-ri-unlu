# Backend config
SEARCH_BACKEND=terrier

# Java (Terrier)
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
JVM_PATH=/usr/lib/jvm/java-17-openjdk-amd64/lib/server/libjvm.so

# Relevancia (pesos del re-rank)
W_SENT=0.5
W_RECENCY=0.3
W_AUTH=0.2

# Meilisearch (si se usa)
MEILI_HOST=http://127.0.0.1:7700
MEILI_API_KEY=
MEILI_INDEX=docs

# RSS adicionales (separados por coma)
EXTRA_FEEDS=

# SEC RSS User-Agent (recomendado)
SEC_USER_AGENT=tp-final-ri-unlu/1.0 tuemail@ejemplo.com

# GDELT (opcional)
GDELT_ENABLED=0
GDELT_DOC_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_MODE=ArtList
GDELT_MAXRECORDS=50
